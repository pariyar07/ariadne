views:
  - name: Scope Topology
    type: table
    filters:
      and:
        - file.ext == "md"
        - file.name == "00 Index"
        - type == "scope-index"
    order:
      - scope_id
      - scope_path
      - parent_scope_id
      - status
      - scope_order
  - name: Lifecycle
    type: table
    filters:
      and:
        - file.ext == "md"
        - file.name == "00 Index"
        - type == "scope-index"
    order:
      - status
      - scope_id
      - scope_path
      - former_scope_paths
