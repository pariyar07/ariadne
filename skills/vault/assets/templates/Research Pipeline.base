# Exact membership only. For a rollup view, add explicit research_boundary
# alternatives for descriptors listed in this boundary's rollup_boundaries.
# Never substitute folder ancestry for descriptor membership.
filters:
  and:
    - 'research_boundary == link("{{research_boundary}}")'
    - or:
        - 'type == "raw-source"'
        - 'type == "research"'
        - 'type == "research-inquiry"'
        - 'type == "research-synthesis"'
views:
  - type: table
    name: "Research Pipeline"
    order:
      - file.name
      - type
      - status
      - research_boundary
      - source_type
      - evidence_role
      - compilation_status
      - inquiries
      - derived_from
      - created
