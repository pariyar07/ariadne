{
  "name": "hermes_both_context_files",
  "files": [
    {
      "path": ".gitignore",
      "content": "CLAUDE.local.md\nGEMINI.local.md\nAGENTS.override.md\n"
    },
    {
      "path": "AGENTS.md",
      "content": "# Agent Instructions\n\n## Commands\n\n- Run `npm test`.\n"
    },
    {
      "path": ".hermes.md",
      "content": "# Hermes Dotfile Context\n\nHermes-specific override.\n"
    },
    {
      "path": "HERMES.md",
      "content": "# Hermes Uppercase Context\n\nAnother Hermes-specific override.\n"
    }
