{
  "name": "macos_private_path_leakage",
  "files": [
    {
      "path": ".gitignore",
      "content": "CLAUDE.local.md\nGEMINI.local.md\nAGENTS.override.md\n"
    },
    {
      "path": "AGENTS.md",
      "content": "# Shared Instructions\n\nPrivate vault path: {{MACOS_PRIVATE_PATH}}\n"
    }
  ],
  "git": {
    "init": true,
    "track": [".gitignore", "AGENTS.md"]
