{
  "name": "git_worktree_root",
  "files": [
    {
      "path": ".gitignore",
      "content": "CLAUDE.local.md\nGEMINI.local.md\nAGENTS.override.md\n"
    },
    {
      "path": "AGENTS.md",
      "content": "# Worktree Instructions\n"
    }
  ],
  "git": {
    "init": true,
    "worktree": true,
    "track": [".gitignore", "AGENTS.md"]
  },
  "expected": {
    "git": {
      "insideWorkTree": true,
      "isLinkedWorktree": true
    },
    "arrays": {
      "trackedInstructionFiles": ["AGENTS.md"]
    }
  }
}
